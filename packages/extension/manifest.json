{
  "manifest_version": 3,
  "name": "GitRun",
  "version": "0.1.0",
  "description": "Run any GitHub repository directly in your browser. No terminal, no installation.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": [
    "*://github.com/*"
  ]
}
